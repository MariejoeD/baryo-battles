[sub_resource type="Shader" id="Shader_o0vlo"]
code = "shader_type sky;
render_mode use_debanding;

uniform vec4 sky_top_color : source_color = vec4(0.385, 0.454, 0.55, 1.0);
uniform vec4 sky_horizon_color : source_color = vec4(0.646, 0.656, 0.67, 1.0);
uniform float sky_curve : hint_range(0, 1) = 0.15;
uniform float sky_energy = 1.0; // In Lux.
uniform sampler2D sky_cover : filter_linear, source_color, hint_default_black;
uniform vec4 sky_cover_modulate : source_color = vec4(1.0, 1.0, 1.0, 1.0);

uniform vec4 ground_bottom_color : source_color = vec4(0.1, 0.35, 0.1, 1.0); // Grass Green
uniform vec4 ground_horizon_color : source_color = vec4(0.4, 0.3, 0.15, 1.0); // Dirt/Soil
uniform float ground_curve : hint_range(0, 1) = 0.02;
uniform float ground_energy = 1.0;
uniform float sun_angle_max = 30.0;
uniform float sun_curve : hint_range(0, 1) = 0.15;
uniform float exposure : hint_range(0, 128) = 1.0;

// Noise function for terrain variation
float hash(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float smoothNoise(vec2 uv) {
    vec2 i = floor(uv);
    vec2 f = fract(uv);
    float a = hash(i);
    float b = hash(i + vec2(1.0, 0.0));
    float c = hash(i + vec2(0.0, 1.0));
    float d = hash(i + vec2(1.0, 1.0));
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;
}

void sky() {
    float v_angle = acos(clamp(EYEDIR.y, -1.0, 1.0));
    float c = (1.0 - v_angle / (PI * 0.5));

    vec3 sky = mix(sky_horizon_color.rgb, sky_top_color.rgb, clamp(1.0 - pow(1.0 - c, 1.0 / sky_curve), 0.0, 1.0));
    sky *= sky_energy;

    vec4 sky_cover_texture = texture(sky_cover, SKY_COORDS);
    sky += (sky_cover_texture.rgb * sky_cover_modulate.rgb) * sky_cover_texture.a * sky_cover_modulate.a * sky_energy;

    // Terrain simulation
    vec2 uv = vec2(EYEDIR.x, EYEDIR.z) * 5.0;
    float terrainHeight = smoothNoise(uv) * 0.5 + 0.5; // Height variation

    c = (v_angle - (PI * 0.5)) / (PI * 0.5);
    vec3 grassColor = vec3(0.1, 0.3, 0.2);  // Lush green grass
    vec3 dirtColor = vec3(0.30, 0.3, 0.15);  // Brown soil patches

    vec3 ground = mix(dirtColor, grassColor, terrainHeight); // Blending grass and soil
    ground *= ground_energy;

    // Final mix of ground and sky
    COLOR = mix(ground, sky, step(0.0, EYEDIR.y)) * exposure;
}
"

